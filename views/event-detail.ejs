<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARDE | <%= event.title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/career.css">
</head>
<body>
    <%- include('navbar', { active: 'events' }) %>
    <script src="/js/navbar.js"></script>

    <main>
        <section class="job-detail-section">
            <div class="job-detail-container">

                <a href="/events" class="back-link">← Back to Events</a>

                <% if (event.image_path) { %>
                <img src="<%= event.image_path %>" alt="<%= event.title %>" class="job-detail-img job-detail-img--poster">
                <% } %>

                <h1><%= event.title %></h1>

                <div class="job-detail-meta">
                    <% if (event.category) { %>
                        <span>&#127991; <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %></span>
                    <% } %>
                    <% if (event.location) { %>
                        <span>&#128205; <%= event.location %></span>
                    <% } %>
                    <% if (event.event_date) { %>
                        <span>&#128197; <%= new Date(event.event_date).toLocaleDateString('en-SG', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    <% } %>
                </div>

                <div class="job-detail-description">
                    <h3>About This Event</h3>
                    <p><%= event.description %></p>
                </div>

            </div>
        </section>

        <!-- REGISTRATION FORM -->
        <% const isUpcoming = new Date(event.event_date) >= new Date(new Date().setHours(0,0,0,0)); %>
        <% if (isUpcoming) { %>
        <section class="apply-section">
            <div class="apply-container">
                <h2>Register Your Interest</h2>
                <p>Event registration is for ARDE members. Enter your member ID to register for <strong><%= event.title %></strong>.</p>

                <% const f = (locals.form || {}); %>
                <% if (locals.error) { %>
                <div style="background:#fdecec; color:#b3261e; padding:12px 16px; border-radius:8px; margin-bottom:18px; font-weight:600;">
                    <%= locals.error %>
                </div>
                <% } %>

                <form action="/events/<%= event.id %>/register" method="POST" class="apply-form">
                    <div class="form-group">
                        <label>Member ID *</label>
                        <input type="text" name="member_id" required maxlength="5"
                               value="<%= f.member_id || '' %>" placeholder="e.g. 04827">
                        <small style="color:#666;">Your 5-digit ARDE membership ID.</small>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Full Name *</label>
                            <input type="text" name="full_name" required value="<%= f.full_name || '' %>" placeholder="John Tan">
                        </div>
                        <div class="form-group">
                            <label>Email Address *</label>
                            <input type="email" name="email" required value="<%= f.email || '' %>" placeholder="john@email.com">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="text" name="phone" value="<%= f.phone || '' %>" placeholder="+65 9123 4567">
                    </div>

                    <div class="form-group">
                        <label>Message</label>
                        <textarea name="message" rows="4" placeholder="Anything you'd like us to know..."><%= f.message || '' %></textarea>
                    </div>

                    <button type="submit" class="apply-btn">Register Interest</button>
                </form>
            </div>
        </section>
        <% } else { %>
        <section class="apply-section">
            <div class="apply-container" style="text-align:center;">
                <p>This event has already taken place.</p>
            </div>
        </section>
        <% } %>

    </main>

    <%- include('footer') %>
</body>
</html>
