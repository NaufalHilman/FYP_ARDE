<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ARDE | Events</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/events.css">
</head>
<body>

  <%- include('navbar', { active: 'events' }) %>
  <script src="/js/navbar.js"></script>

  <%
  function pad(n) { return String(n).padStart(2, '0'); }
  const MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  function day(d)  { return pad(new Date(d).getDate()); }
  function mon(d)  { return MONTHS[new Date(d).getMonth()]; }
  function year(d) { return new Date(d).getFullYear(); }
  function cap(s)  { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }
  %>

  <main>

    <!-- =====================================================
         HERO A — Events (default)
         ===================================================== -->
    <section class="banner-hero events-hero" id="eventsHero">
      <div class="hero-shape"></div>
      <div class="hero-shape2"></div>
      <div class="hero-inner">
        <div class="hero-text">
          <span class="hero-eyebrow">ARDE Events</span>
          <h1 class="hero-heading">
            Events &amp; <span class="hero-accent">Industry</span> Engagement
          </h1>
          <p class="hero-sub">
            Showcasing upcoming events, networking opportunities, workshops, competitions, and member engagement activities within Singapore's hospitality industry.
          </p>
          <div class="hero-actions">
            <a href="#upcomingSection" class="btn-hero-primary">Explore Events</a>
          </div>
        </div>
        <div class="hero-image-block">
          <div class="hero-image-wrap">
            <img src="/images/award_banner.jpg" alt="ARDE Events" style="object-position: center center;">
            <div class="hero-image-badge">
              <span class="badge-dot" style="background:#FFCB05;"></span>
              <span>Now Open for Registration</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
         FLASH MESSAGES
         ===================================================== -->
    <% if (notice) { %>
    <div class="flash flash--notice"><%= notice %></div>
    <% } %>
    <% if (error) { %>
    <div class="flash flash--error"><%= error %></div>
    <% } %>

    <!-- =====================================================
         WHY IT MATTERS — shown with events, hidden with Awards tab
         ===================================================== -->
    <section class="why-section" id="whySection">
      <div class="why-section__inner">
        <div class="why-section__text">
          <span class="why-section__tag">Why It Matters</span>
          <h2 class="why-section__title">More Than Just Gatherings</h2>
          <p class="why-section__desc">ARDE's events go beyond simple gatherings. We are part of a larger effort to uplift the hospitality industry — helping members grow at every stage of their career journey.</p>
        </div>
        <ul class="why-section__list">
          <li><span class="why-section__dot"></span>Professional networking opportunities</li>
          <li><span class="why-section__dot"></span>Exposure to hospitality best practices</li>
          <li><span class="why-section__dot"></span>Career development and mentorship</li>
          <li><span class="why-section__dot"></span>Industry trend updates and market insights</li>
          <li><span class="why-section__dot"></span>Learning journeys and hotel visits</li>
          <li><span class="why-section__dot"></span>Skills enhancement workshops</li>
          <li><span class="why-section__dot"></span>Opportunities to connect with hospitality leaders and peers</li>
        </ul>
      </div>
    </section>

        <!-- =====================================================
         FILTER TABS: All Events | Networking | Workshops
         ===================================================== -->
    <section class="filter-tabs-wrap">
      <div class="filter-tabs" role="tablist" aria-label="Filter events by category">
        <button class="filter-tabs__btn filter-tabs__btn--active" data-filter="all"        role="tab" aria-selected="true">All Events</button>
        <button class="filter-tabs__btn"                          data-filter="networking" role="tab" aria-selected="false">Networking</button>
        <button class="filter-tabs__btn"                          data-filter="workshop"   role="tab" aria-selected="false">Workshops</button>
      </div>
    </section>
    
    <!-- =====================================================
         2. FEATURED EVENT (always visible)
         ===================================================== -->
    <% if (featured) { %>
    <section class="featured-event" id="featuredSection">
      <div class="featured-event__header">
        <div class="featured-event__eyebrow">
          <span class="featured-event__eyebrow-bar" aria-hidden="true"></span>
          FEATURED EVENT
        </div>
        <h2 class="featured-event__heading">Don't Miss Out</h2>
      </div>
      <div class="featured-event__container container">
        <div class="featured-event__card">
          <div class="featured-event__info">
            <span class="featured-event__pill"><%= cap(featured.category) %></span>
            <h3 class="featured-event__title"><%= featured.title %></h3>
            <p class="featured-event__desc"><%= featured.description %></p>
            <div class="featured-event__bottom-row">
              <div class="featured-event__date-badge">
                <span class="featured-event__date-day"><%= day(featured.event_date) %></span>
                <span class="featured-event__date-month"><%= mon(featured.event_date) %></span>
              </div>
              <p class="featured-event__location">
                <svg class="featured-event__location-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= featured.location %>
              </p>
              <a href="/events/<%= featured.id %>" class="btn btn--primary btn--pill featured-event__cta">Register Now →</a>
            </div>
          </div>
          <div class="featured-event__photo">
            <img src="<%= featured.image_path %>" alt="<%= featured.title %>" class="featured-event__img" loading="lazy">
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <!-- =====================================================
         3. UPCOMING EVENTS
         ===================================================== -->
    <section class="events-section" id="upcomingSection">
      <div class="events-section__header">
        <p class="events-section__eyebrow">Upcoming Events</p>
        <h2 class="events-section__title">What's Next</h2>
      </div>

      <div class="events-scroll" id="upcomingScroll">
        <div class="events-scroll__track" id="upcomingTrack">

          <% if (upcoming.length === 0) { %>
            <p style="padding-left:100px;color:#777;">No upcoming events at the moment.</p>
          <% } %>

          <% upcoming.forEach(ev => { %>
          <article class="event-card" data-category="<%= ev.category %>">
            <div class="event-card__info">
              <div class="event-card__top-row">
                <div class="event-card__date-badge">
                  <span class="event-card__date-day"><%= day(ev.event_date) %></span>
                  <span class="event-card__date-month"><%= mon(ev.event_date) %></span>
                </div>
                <span class="event-card__pill event-card__pill--<%= ev.category %>"><%= cap(ev.category) %></span>
              </div>
              <h3 class="event-card__title"><%= ev.title %></h3>
              <p class="event-card__meta"><%= ev.location %></p>
              <a href="/events/<%= ev.id %>" class="event-card__link">Learn More →</a>
            </div>
            <div class="event-card__photo">
              <img src="<%= ev.image_path %>" alt="<%= ev.title %>" class="event-card__img" loading="lazy">
            </div>
          </article>
          <% }) %>

        </div>
      </div>
    </section>

    <!-- =====================================================
         4. PAST EVENTS
         ===================================================== -->
    <section class="events-section events-section--past" id="pastSection">
      <div class="events-section__header">
        <p class="events-section__eyebrow">Past Events</p>
        <h2 class="events-section__title">Event Gallery</h2>
      </div>

      <div class="events-scroll">
        <div class="events-scroll__track">

          <% if (past.length === 0) { %>
            <p style="padding-left:100px;color:#777;">No past events yet.</p>
          <% } %>

          <% past.forEach(ev => { %>
          <article class="event-card event-card--past" data-category="<%= ev.category %>">
            <div class="event-card__photo">
              <span class="event-card__year-badge"><%= year(ev.event_date) %></span>
              <img src="<%= ev.image_path %>" alt="<%= ev.title %>" class="event-card__img" loading="lazy">
            </div>
            <div class="event-card__info">
              <h3 class="event-card__title"><%= ev.title %></h3>
              <p class="event-card__meta"><%= cap(ev.category) %></p>
              <a href="/events/<%= ev.id %>" class="event-card__link">View Recap →</a>
            </div>
          </article>
          <% }) %>

        </div>
      </div>
    </section>

  </main>

  <%- include('footer') %>

  <script src="/js/events.js"></script>
  <script>
    // ===== FILTER TABS =====
    const filterBtns     = document.querySelectorAll('.filter-tabs__btn');
    const upcomingSection = document.getElementById('upcomingSection');
    const pastSection     = document.getElementById('pastSection');
    const featuredSection = document.getElementById('featuredSection');
    const whySection      = document.getElementById('whySection');

    function applyFilter(filter) {
      const isAll = filter === 'all';

      if (upcomingSection) upcomingSection.style.display = '';
      if (pastSection)     pastSection.style.display     = '';

      // Why It Matters + Featured Event only on "All Events"
      if (whySection)      whySection.style.display      = isAll ? '' : 'none';
      if (featuredSection) featuredSection.style.display = isAll ? '' : 'none';

      // Filter event cards for Networking / Workshops / All
      document.querySelectorAll('.event-card').forEach(card => {
        const match = isAll || card.dataset.category === filter;
        card.style.display = match ? '' : 'none';
      });

      // Update tab active state
      filterBtns.forEach(b => {
        b.classList.toggle('filter-tabs__btn--active', b.dataset.filter === filter);
        b.setAttribute('aria-selected', b.dataset.filter === filter);
      });

      history.replaceState(null, '', isAll ? '#' : '#' + filter);
    }

    filterBtns.forEach(btn => btn.addEventListener('click', () => applyFilter(btn.dataset.filter)));

    // Honour URL hash on load (#networking, #workshop)
    const hash = window.location.hash.replace('#', '');
    if (['networking','workshop'].includes(hash)) {
      applyFilter(hash);
    }
  </script>

</body>
</html>
