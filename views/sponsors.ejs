<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ARDE | Sponsors & Partners</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/sponsors.css">
</head>
<body>
    <%- include('navbar', { active: 'about' }) %>
    <script src="/js/navbar.js"></script>

    <main>
        <!-- HERO SECTION -->
        <section class="sponsors-hero">
            <div class="hero-shape"></div>
            <div class="hero-shape2"></div>
            <div class="sponsors-hero-inner">
                <p class="hero-eyebrow">Our Supporters</p>
                <h1>Sponsors <span>&amp;</span> <span>Partners</span></h1>
                <p class="hero-desc">
                    We are grateful for the support of our valued sponsors and partners 
                    who make ARDE's mission and programs possible.
                </p>
            </div>
        </section>

        <!-- INTRODUCTION SECTION -->
        <section class="sponsors-intro-section">
            <div class="sponsors-intro-container">
                <div class="intro-content">
                    <h2>Partner with ARDE</h2>
                    <p>
                        The Association of Rooms Division Executives (ARDE) welcomes collaborations with organisations 
                        and industry partners who share our commitment to developing hospitality professionals and 
                        strengthening the hospitality community in Singapore.
                    </p>
                    <p>
                        Sponsors gain valuable exposure through ARDE events, competitions, workshops, networking sessions, 
                        and digital platforms while connecting with hospitality leaders, hotel professionals, and 
                        decision-makers across Singapore.
                    </p>
                </div>
                <div class="cta-container">
                    <h3>Let's build the future of hospitality together</h3>
                    <a href="/contact" class="btn-partner-large">Enquire About Sponsorship</a>
                </div>
            </div>
        </section>

        <!-- STRATEGIC PARTNERS SECTION -->
        <section class="partners-section">
            <div class="partners-container">
                <div class="section-header">
                    <span class="section-label">Previous Collaborations</span>
                    <h2>Our <strong>Valued Partners</strong></h2>
                </div>

                <div class="partners-grid">
                    <% if (sponsors && sponsors.length > 0) { %>
                        <% sponsors.forEach(sponsor => { %>
                            <div class="partner-card">
                                <% if (sponsor.logo_path) { %>
                                    <div class="partner-logo-wrapper">
                                        <img src="<%= sponsor.logo_path %>" alt="<%= sponsor.company_name %> Logo">
                                    </div>
                                <% } %>
                                <h3><%= sponsor.company_name %></h3>
                                <% if (sponsor.description) { %>
                                    <p class="partner-description"><%= sponsor.description %></p>
                                <% } %>
                                <% if (sponsor.website) { %>
                                    <a href="<%= sponsor.website %>" class="btn-partner-large" target="_blank" rel="noreferrer">Visit Website</a>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="partner-card">
                            <div class="partner-logo-wrapper">
                                <img src="/images/rp pic.gif" alt="Republic Polytechnic Logo">
                            </div>
                            <h3>Republic Polytechnic (RP)</h3>
                            <p class="partner-description">
                                Collaboration on workshops and hospitality-related learning initiatives to support the 
                                professional development of hospitality students and industry professionals.
                            </p>
                        </div>

                        <div class="partner-card">
                            <div class="partner-logo-wrapper">
                                <img src="/images/alcatel-lucent.webp" alt="Alcatel-Lucent Logo">
                            </div>
                            <h3>Alcatel-Lucent</h3>
                            <p class="partner-description">
                                Supporting online seminars and industry sharing sessions to keep hospitality professionals 
                                informed on the latest communication technologies and industry trends.
                            </p>
                        </div>

                        <div class="partner-card">
                            <div class="partner-logo-wrapper">
                                <img src="/images/shatec.jpeg" alt="SHATEC Logo">
                            </div>
                            <h3>SHATEC &amp; Republic Polytechnic</h3>
                            <p class="partner-description">
                                Contributions and support for the Singapore Best Receptionist Competition (SBRC), 
                                recognizing excellence in front-line hospitality services and professional standards.
                            </p>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- BENEFITS OF PARTNERSHIP SECTION -->
        <section class="partnership-benefits-section">
            <div class="benefits-container">
                <div class="benefits-header">
                    <h2>Who We Are Looking For</h2>
                    <p>ARDE welcomes partnerships with organisations related to the hospitality and tourism industry, including:</p>
                </div>

                <div class="benefits-grid">
                    
                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
                                <path d="M13 22C13 20.3431 14.3431 19 16 19C17.6569 19 19 20.3431 19 22M28 22C28 20.3431 26.6569 19 25 19C23.3431 19 22 20.3431 22 22M11 28C11 24.6863 13.6863 22 17 22H23C26.3137 22 29 24.6863 29 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h3>Telecommunications Providers</h3>
                        <p>Communications and connectivity solutions for hospitality operations and guest experiences.</p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
                                <path d="M14 15C12.3431 15 11 16.3431 11 18V28C11 29.6569 12.3431 31 14 31H26C27.6569 31 29 29.6569 29 28V18C29 16.3431 27.6569 15 26 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M20 12V15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h3>Limousine &amp; Transport Services</h3>
                        <p>Premium transportation and mobility solutions for hotel guests and hospitality professionals.</p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
                                <rect x="12" y="12" width="16" height="16" rx="2" stroke="currentColor" stroke-width="2"/>
                                <path d="M12 17H28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h3>Hospitality Technology Providers</h3>
                        <p>Software solutions and digital platforms that enhance hotel operations and guest services.</p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
                                <path d="M20 12V28M12 16H28C29.1046 16 30 16.8954 30 18V26C30 27.1046 29.1046 28 28 28H12C10.8954 28 10 27.1046 10 26V18C10 16.8954 10.8954 16 12 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h3>Educational Institutions</h3>
                        <p>Hospitality schools and training centers developing the next generation of industry professionals.</p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
                                <path d="M20 11L24.472 21.528H35.944L26.236 26.472L28.708 37L20 32.056L11.292 37L13.764 26.472L4.056 21.528H15.528L20 11Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h3>Hotel Suppliers &amp; Vendors</h3>
                        <p>Hospitality equipment, amenities, and service providers that support hotel operations.</p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
                                <path d="M14 18C14 16.3432 15.3431 15 17 15C18.6569 15 20 16.3432 20 18M26 18C26 16.3432 24.6569 15 23 15C21.3431 15 20 16.3432 20 18M20 18V26" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M13 26C13 23.2386 15.2386 21 18 21H22C24.7614 21 27 23.2386 27 26V28H13V26Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h3>Training &amp; Development Partners</h3>
                        <p>Professional development and capacity-building organizations supporting continuous learning.</p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
                                <path d="M14 24C14 21.2386 16.2386 19 19 19H21C23.7614 19 26 21.2386 26 24V28H14V24Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M18 17C17.4477 17 17 16.5523 17 16C17 15.4477 17.4477 15 18 15C18.5523 15 19 15.4477 19 16C19 16.5523 18.5523 17 18 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M22 17C21.4477 17 21 16.5523 21 16C21 15.4477 21.4477 15 22 15C22.5523 15 23 15.4477 23 16C23 16.5523 22.5523 17 22 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h3>Lifestyle &amp; Service Brands</h3>
                        <p>Premium brands offering products and services that align with hospitality excellence.</p>
                    </div>

                </div>
            </div>
        </section>

        <!-- PARTNERSHIP TIERS SECTION -->
        <section class="partnership-tiers-section">
            <div class="tiers-container">
                <div class="tiers-header">
                    <h2>Types of <strong>Support</strong></h2>
                    <p>ARDE welcomes diverse forms of partnership and collaboration to achieve mutual goals.</p>
                </div>

                <div class="tiers-grid">

                    <div class="tier-card tier-bronze">
                        <div class="tier-badge">Support Type</div>
                        <h3>Financial Sponsorships</h3>
                        <p class="tier-desc">Monetary contributions to support ARDE's programs, events, and initiatives.</p>
                        <ul class="tier-features">
                            <li>Event sponsorship opportunities</li>
                            <li>Program funding partnerships</li>
                            <li>Award and recognition support</li>
                            <li>Educational initiative funding</li>
                        </ul>
                    </div>

                    <div class="tier-card tier-silver">
                        <div class="tier-badge">Support Type</div>
                        <h3>Event &amp; Product Partnerships</h3>
                        <p class="tier-desc">Collaborate on ARDE events or provide products and services.</p>
                        <ul class="tier-features">
                            <li>Co-hosted events and workshops</li>
                            <li>Product sponsorships</li>
                            <li>Venue and equipment support</li>
                            <li>Hospitality experience contributions</li>
                        </ul>
                    </div>

                    <div class="tier-card tier-gold tier-featured">
                        <div class="tier-badge tier-featured-badge">Support Type</div>
                        <h3>Educational &amp; Strategic Collaborations</h3>
                        <p class="tier-desc">Develop long-term partnerships focused on learning and industry development.</p>
                        <ul class="tier-features">
                            <li>Training and curriculum partnerships</li>
                            <li>Knowledge sharing sessions</li>
                            <li>Collaborative program development</li>
                            <li>Industry mentorship initiatives</li>
                            <li>Strategic industry partnerships</li>
                        </ul>
                    </div>

                </div>
            </div>
        </section>

        <!-- CALL TO ACTION SECTION -->
        <section class="sponsors-cta-section">
            <div class="cta-inner">
                <h2>Join Us in Strengthening Singapore's Hospitality Community</h2>
                <p>Support the growth and development of hospitality professionals while gaining valuable exposure and industry connections through ARDE.</p>
                <a href="/contact" class="btn-cta-primary">Enquire About Sponsorship</a>
            </div>
        </section>

    </main>

    <%- include('footer') %>
</body>
</html>
