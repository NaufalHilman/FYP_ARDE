<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARDE | Executive Committee</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/members.css">
</head>
<body>
    <%- include('navbar', { active }) %>
    <script src="/js/navbar.js"></script>

    <main>
        <section class="members-hero">
            <div class="hero-shape"></div>
            <div class="hero-shape2"></div>
            <div class="members-hero-inner">
                <p class="hero-eyebrow">Leadership of ARDE</p>
                <h1>Executive <span>Committee</span></h1>
                <p class="hero-desc">
                    The Executive Committee guides ARDE's mission to develop, connect,
                    and elevate Rooms Division professionals across Singapore's
                    hospitality industry.
                </p>
            </div>
        </section>

        <% if (president) { %>
        <section class="president-section">
            <div class="president-inner">
                <div class="president-photo">
                    <% if (president.image_path) { %>
                        <img src="<%= president.image_path %>" alt="<%= president.full_name %>">
                    <% } else { %>
                        <div class="photo-placeholder"><%= president.full_name.charAt(0) %></div>
                    <% } %>
                </div>
                <div class="president-info">
                    <span class="president-tag">President</span>
                    <h2><%= president.full_name %></h2>
                    <p class="president-title"><%= president.title %></p>
                    <p class="president-vision">"<%= president.president_vision %>"</p>
                </div>
            </div>
        </section>
        <% } %>

        <section class="leadership-section">
            <div class="leadership-inner">
                <div class="section-header">
                    <span class="section-label">Our Team</span>
                    <h2>Leadership <strong>Teams</strong></h2>
                </div>

                <% groupedExecutives.forEach(group => { %>
                <div class="leadership-group">
                    <h3 class="group-title"><%= group.group_name %></h3>
                    <div class="leadership-grid">
                        <% group.members.forEach(member => { %>
                        <div class="leader-card">
                            <div class="leader-photo">
                                <% if (member.image_path) { %>
                                    <img src="<%= member.image_path %>" alt="<%= member.full_name %>">
                                <% } else { %>
                                    <div class="photo-placeholder"><%= member.full_name.charAt(0) %></div>
                                <% } %>
                            </div>
                            <h4><%= member.full_name %></h4>
                            <p class="leader-role"><%= member.title %></p>
                            <% if (member.description) { %>
                                <p class="leader-desc"><%= member.description %></p>
                            <% } %>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% }) %>
            </div>
        </section>
    </main>

    <%- include('footer') %>
</body>
</html>
